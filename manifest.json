    "picker": "ui/Picker.qml",
    "settings": "ui/Settings.qml"
  },
  "actions": [
    {
      "id": "playlist",
      "label": "Add to playlist",
      "icon": "playlist_add",
      "types": [
        "Movie",
        "Episode",
        "Audio",
        "MusicAlbum",
        "Video"
      ]
    },
    {
      "id": "delete",
      "label": "Delete from server",
      "icon": "delete"
    }
  ]
}
