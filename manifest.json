{
  "format": 3,
  "id": "spool.plex",
  "name": "Plex",
  "version": "0.1.9",
  "publisher": "Spool",
  "summary": "Your Plex Media Server",
  "homepage": "https://github.com/spool-player/spool-plex",
  "icon": "assets/icon.png",
  "entry": "logic/provider.mjs",
  "capabilities": [
    "search",
    "userState",
    "reporting",
    "segments",
    "streamQuality",
    "trickplay",
    "downloads",
    "downloadTranscode",
    "speedTest",
    "suggestions",
    "itemActions",
    "collectionEditing",
    "playbackQueueReporting",
    "remoteTargets",
    "httpMetadata",
    "originGrants",
    "accountActivation"
